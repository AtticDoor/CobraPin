.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reports
sysinfo.txt

# Mono auto generated
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
**/*_BackUpThisFolder_ButDontShipItWithYourGame/
**/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# Blender backups
**/[Aa]ssets/**/*.blend1
**/[Aa]ssets/**/*.blend1.meta

# TouchDesigner cache
**/[Aa]ssets/**/TDImportCache/
**/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery
**/[Aa]ssets/_Recovery/
**/[Aa]ssets/_Recovery.meta

